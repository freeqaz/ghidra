# SLEIGH definitions for the IBM/Nintendo Gekko (PowerPC 750CL) and
# Broadway (PowerPC 750CL+) paired-single extension used by the Nintendo
# GameCube and Wii.
#
# This file extends the `instr(32)` token defined in ppc_common.sinc with
# additional bit fields used by paired-single load/store quantization, and
# adds constructors for:
#
#   * D-form paired-single loads/stores  (primary opcodes 56, 57, 60, 61)
#   * X-form paired-single loads/stores  (primary opcode 4, XO 6/7/38/39)
#   * A-form paired-single arithmetic    (primary opcode 4, 5-bit XO)
#   * X-form paired-single moves/merges  (primary opcode 4, 10-bit XO)
#
# Reference: IBM "PowerPC 750CL RISC Microprocessor User's Manual" Chapter 4
# ("Paired-Single Floating-Point Operations").
#
# Arithmetic is modelled with pcodeops because each instruction operates on
# the two 32-bit halves of an FPR as a vector. Loads/stores model the PS0
# (high-word) memory transfer directly and call a pcodeop to update PS1 from
# the quantized form when the W bit is zero. With W=0 and I=0 (qr0,
# unquantized) this matches lfd/stfd semantics, which covers the GPR/FPR
# save/restore prologue patterns generated by Metrowerks CodeWarrior.

# Effective address subconstructors for D-form paired-single loads/stores.
# psq_l/psq_st use RA_OR_ZERO; psq_lu/psq_stu use RA and write-back.
psqDispRaOrZero:    psq_D(RA_OR_ZERO)   is psq_D & RA_OR_ZERO   { tmp:$(REGISTER_SIZE) = RA_OR_ZERO + psq_D; export tmp; }
psqDispRa:          psq_D(A)            is psq_D & A            { tmp:$(REGISTER_SIZE) = A + psq_D; export tmp; }

# Paired-single arithmetic pcodeops (truly vector operations on PS0/PS1).
define pcodeop ps_add_op;
define pcodeop ps_sub_op;
define pcodeop ps_mul_op;
define pcodeop ps_muls0_op;
define pcodeop ps_muls1_op;
define pcodeop ps_div_op;
define pcodeop ps_madd_op;
define pcodeop ps_madds0_op;
define pcodeop ps_madds1_op;
define pcodeop ps_msub_op;
define pcodeop ps_nmadd_op;
define pcodeop ps_nmsub_op;
define pcodeop ps_sel_op;
define pcodeop ps_res_op;
define pcodeop ps_rsqrte_op;
define pcodeop ps_sum0_op;
define pcodeop ps_sum1_op;
define pcodeop ps_mr_op;
define pcodeop ps_neg_op;
define pcodeop ps_abs_op;
define pcodeop ps_nabs_op;
define pcodeop ps_merge00_op;
define pcodeop ps_merge01_op;
define pcodeop ps_merge10_op;
define pcodeop ps_merge11_op;
define pcodeop ps_cmp_op;
define pcodeop psq_load_quantized;
define pcodeop psq_store_quantized;

################################################################
# D-form paired-single load/store
################################################################

# psq_l  rD, d(rA), W, I    OP=56
:psq_l  fD,psqDispRaOrZero,psq_W,psq_I  is $(NOTVLE) & OP=56 & fD & psqDispRaOrZero & psq_W & psq_I
{
    fD = *:8(psqDispRaOrZero);
    psq_load_quantized(fD, psq_W:1, psq_I:1);
}

# psq_lu rD, d(rA), W, I    OP=57   (update form: rA must be non-zero, write-back)
:psq_lu fD,psqDispRa,psq_W,psq_I        is $(NOTVLE) & OP=57 & fD & psqDispRa & A & psq_W & psq_I
{
    ea:$(REGISTER_SIZE) = psqDispRa;
    fD = *:8(ea);
    psq_load_quantized(fD, psq_W:1, psq_I:1);
    A = ea;
}

# psq_st rS, d(rA), W, I    OP=60
:psq_st fS,psqDispRaOrZero,psq_W,psq_I  is $(NOTVLE) & OP=60 & fS & psqDispRaOrZero & psq_W & psq_I
{
    psq_store_quantized(fS, psq_W:1, psq_I:1);
    *:8(psqDispRaOrZero) = fS;
}

# psq_stu rS, d(rA), W, I   OP=61
:psq_stu fS,psqDispRa,psq_W,psq_I       is $(NOTVLE) & OP=61 & fS & psqDispRa & A & psq_W & psq_I
{
    ea:$(REGISTER_SIZE) = psqDispRa;
    psq_store_quantized(fS, psq_W:1, psq_I:1);
    *:8(ea) = fS;
    A = ea;
}

################################################################
# X-form paired-single load/store (indexed)
# OP=4, XO at bits 1-6 (psq_XO6); W at bit 10; I at bits 7-9.
################################################################

:psq_lx  fD,RA_OR_ZERO,B,psq_WX,psq_IX   is $(NOTVLE) & OP=4 & fD & RA_OR_ZERO & B & psq_WX & psq_IX & psq_XO6=6 & BIT_0=0
{
    ea:$(REGISTER_SIZE) = RA_OR_ZERO + B;
    fD = *:8(ea);
    psq_load_quantized(fD, psq_WX:1, psq_IX:1);
}

:psq_stx fS,RA_OR_ZERO,B,psq_WX,psq_IX   is $(NOTVLE) & OP=4 & fS & RA_OR_ZERO & B & psq_WX & psq_IX & psq_XO6=7 & BIT_0=0
{
    ea:$(REGISTER_SIZE) = RA_OR_ZERO + B;
    psq_store_quantized(fS, psq_WX:1, psq_IX:1);
    *:8(ea) = fS;
}

:psq_lux fD,A,B,psq_WX,psq_IX            is $(NOTVLE) & OP=4 & fD & A & B & psq_WX & psq_IX & psq_XO6=38 & BIT_0=0
{
    ea:$(REGISTER_SIZE) = A + B;
    fD = *:8(ea);
    psq_load_quantized(fD, psq_WX:1, psq_IX:1);
    A = ea;
}

:psq_stux fS,A,B,psq_WX,psq_IX           is $(NOTVLE) & OP=4 & fS & A & B & psq_WX & psq_IX & psq_XO6=39 & BIT_0=0
{
    ea:$(REGISTER_SIZE) = A + B;
    psq_store_quantized(fS, psq_WX:1, psq_IX:1);
    *:8(ea) = fS;
    A = ea;
}

################################################################
# A-form paired-single arithmetic
# OP=4, 5-bit XO at bits 1-5 (XOP_1_5), Rc at bit 0.
################################################################

# 3-operand: fT = op(fA, fB) — fC field (bits 6-10) is reserved
:ps_div  fD,fA,fB        is $(NOTVLE) & OP=4 & fD & fA & fB & BITS_6_10=0 & XOP_1_5=18 & Rc=0  { fD = ps_div_op(fA, fB); }
:ps_div. fD,fA,fB        is $(NOTVLE) & OP=4 & fD & fA & fB & BITS_6_10=0 & XOP_1_5=18 & Rc=1  { fD = ps_div_op(fA, fB); cr1flags(); }
:ps_sub  fD,fA,fB        is $(NOTVLE) & OP=4 & fD & fA & fB & BITS_6_10=0 & XOP_1_5=20 & Rc=0  { fD = ps_sub_op(fA, fB); }
:ps_sub. fD,fA,fB        is $(NOTVLE) & OP=4 & fD & fA & fB & BITS_6_10=0 & XOP_1_5=20 & Rc=1  { fD = ps_sub_op(fA, fB); cr1flags(); }
:ps_add  fD,fA,fB        is $(NOTVLE) & OP=4 & fD & fA & fB & BITS_6_10=0 & XOP_1_5=21 & Rc=0  { fD = ps_add_op(fA, fB); }
:ps_add. fD,fA,fB        is $(NOTVLE) & OP=4 & fD & fA & fB & BITS_6_10=0 & XOP_1_5=21 & Rc=1  { fD = ps_add_op(fA, fB); cr1flags(); }

# 4-operand: fT = op(fA, fC, fB)
:ps_sel    fD,fA,fC,fB   is $(NOTVLE) & OP=4 & fD & fA & fC & fB & XOP_1_5=23 & Rc=0  { fD = ps_sel_op(fA, fC, fB); }
:ps_sel.   fD,fA,fC,fB   is $(NOTVLE) & OP=4 & fD & fA & fC & fB & XOP_1_5=23 & Rc=1  { fD = ps_sel_op(fA, fC, fB); cr1flags(); }

# 2-operand: fT = op(fB) — fA field (bits 16-20) and fC field reserved
:ps_res    fD,fB         is $(NOTVLE) & OP=4 & fD & BITS_16_20=0 & fB & BITS_6_10=0 & XOP_1_5=24 & Rc=0  { fD = ps_res_op(fB); }
:ps_res.   fD,fB         is $(NOTVLE) & OP=4 & fD & BITS_16_20=0 & fB & BITS_6_10=0 & XOP_1_5=24 & Rc=1  { fD = ps_res_op(fB); cr1flags(); }

# 3-operand: fT = op(fA, fC) — fB field (bits 11-15) reserved
:ps_mul    fD,fA,fC      is $(NOTVLE) & OP=4 & fD & fA & BITS_11_15=0 & fC & XOP_1_5=25 & Rc=0  { fD = ps_mul_op(fA, fC); }
:ps_mul.   fD,fA,fC      is $(NOTVLE) & OP=4 & fD & fA & BITS_11_15=0 & fC & XOP_1_5=25 & Rc=1  { fD = ps_mul_op(fA, fC); cr1flags(); }

:ps_rsqrte fD,fB         is $(NOTVLE) & OP=4 & fD & BITS_16_20=0 & fB & BITS_6_10=0 & XOP_1_5=26 & Rc=0  { fD = ps_rsqrte_op(fB); }
:ps_rsqrte. fD,fB        is $(NOTVLE) & OP=4 & fD & BITS_16_20=0 & fB & BITS_6_10=0 & XOP_1_5=26 & Rc=1  { fD = ps_rsqrte_op(fB); cr1flags(); }

# 4-operand fused multiply-add family
:ps_msub   fD,fA,fC,fB   is $(NOTVLE) & OP=4 & fD & fA & fC & fB & XOP_1_5=28 & Rc=0  { fD = ps_msub_op(fA, fC, fB); }
:ps_msub.  fD,fA,fC,fB   is $(NOTVLE) & OP=4 & fD & fA & fC & fB & XOP_1_5=28 & Rc=1  { fD = ps_msub_op(fA, fC, fB); cr1flags(); }
:ps_madd   fD,fA,fC,fB   is $(NOTVLE) & OP=4 & fD & fA & fC & fB & XOP_1_5=29 & Rc=0  { fD = ps_madd_op(fA, fC, fB); }
:ps_madd.  fD,fA,fC,fB   is $(NOTVLE) & OP=4 & fD & fA & fC & fB & XOP_1_5=29 & Rc=1  { fD = ps_madd_op(fA, fC, fB); cr1flags(); }
:ps_nmsub  fD,fA,fC,fB   is $(NOTVLE) & OP=4 & fD & fA & fC & fB & XOP_1_5=30 & Rc=0  { fD = ps_nmsub_op(fA, fC, fB); }
:ps_nmsub. fD,fA,fC,fB   is $(NOTVLE) & OP=4 & fD & fA & fC & fB & XOP_1_5=30 & Rc=1  { fD = ps_nmsub_op(fA, fC, fB); cr1flags(); }
:ps_nmadd  fD,fA,fC,fB   is $(NOTVLE) & OP=4 & fD & fA & fC & fB & XOP_1_5=31 & Rc=0  { fD = ps_nmadd_op(fA, fC, fB); }
:ps_nmadd. fD,fA,fC,fB   is $(NOTVLE) & OP=4 & fD & fA & fC & fB & XOP_1_5=31 & Rc=1  { fD = ps_nmadd_op(fA, fC, fB); cr1flags(); }

# Cross-lane sum and lane-selected multiply-add (4-operand)
:ps_sum0   fD,fA,fC,fB   is $(NOTVLE) & OP=4 & fD & fA & fC & fB & XOP_1_5=10 & Rc=0  { fD = ps_sum0_op(fA, fC, fB); }
:ps_sum0.  fD,fA,fC,fB   is $(NOTVLE) & OP=4 & fD & fA & fC & fB & XOP_1_5=10 & Rc=1  { fD = ps_sum0_op(fA, fC, fB); cr1flags(); }
:ps_sum1   fD,fA,fC,fB   is $(NOTVLE) & OP=4 & fD & fA & fC & fB & XOP_1_5=11 & Rc=0  { fD = ps_sum1_op(fA, fC, fB); }
:ps_sum1.  fD,fA,fC,fB   is $(NOTVLE) & OP=4 & fD & fA & fC & fB & XOP_1_5=11 & Rc=1  { fD = ps_sum1_op(fA, fC, fB); cr1flags(); }
:ps_muls0  fD,fA,fC      is $(NOTVLE) & OP=4 & fD & fA & BITS_11_15=0 & fC & XOP_1_5=12 & Rc=0  { fD = ps_muls0_op(fA, fC); }
:ps_muls0. fD,fA,fC      is $(NOTVLE) & OP=4 & fD & fA & BITS_11_15=0 & fC & XOP_1_5=12 & Rc=1  { fD = ps_muls0_op(fA, fC); cr1flags(); }
:ps_muls1  fD,fA,fC      is $(NOTVLE) & OP=4 & fD & fA & BITS_11_15=0 & fC & XOP_1_5=13 & Rc=0  { fD = ps_muls1_op(fA, fC); }
:ps_muls1. fD,fA,fC      is $(NOTVLE) & OP=4 & fD & fA & BITS_11_15=0 & fC & XOP_1_5=13 & Rc=1  { fD = ps_muls1_op(fA, fC); cr1flags(); }
:ps_madds0 fD,fA,fC,fB   is $(NOTVLE) & OP=4 & fD & fA & fC & fB & XOP_1_5=14 & Rc=0  { fD = ps_madds0_op(fA, fC, fB); }
:ps_madds0. fD,fA,fC,fB  is $(NOTVLE) & OP=4 & fD & fA & fC & fB & XOP_1_5=14 & Rc=1  { fD = ps_madds0_op(fA, fC, fB); cr1flags(); }
:ps_madds1 fD,fA,fC,fB   is $(NOTVLE) & OP=4 & fD & fA & fC & fB & XOP_1_5=15 & Rc=0  { fD = ps_madds1_op(fA, fC, fB); }
:ps_madds1. fD,fA,fC,fB  is $(NOTVLE) & OP=4 & fD & fA & fC & fB & XOP_1_5=15 & Rc=1  { fD = ps_madds1_op(fA, fC, fB); cr1flags(); }

################################################################
# X-form paired-single moves/merges and compares
# OP=4, 10-bit XO at bits 1-10 (XOP_1_10), Rc at bit 0.
################################################################

# Compares — fT field (bits 21-25) high 3 bits select CR field; bits 21-22 reserved
:ps_cmpu0 CRFD,fA,fB    is $(NOTVLE) & OP=4 & CRFD & BITS_21_22=0 & fA & fB & XOP_1_10=0   & Rc=0  { ps_cmp_op(CRFD, fA, fB); }
:ps_cmpo0 CRFD,fA,fB    is $(NOTVLE) & OP=4 & CRFD & BITS_21_22=0 & fA & fB & XOP_1_10=32  & Rc=0  { ps_cmp_op(CRFD, fA, fB); }
:ps_cmpu1 CRFD,fA,fB    is $(NOTVLE) & OP=4 & CRFD & BITS_21_22=0 & fA & fB & XOP_1_10=64  & Rc=0  { ps_cmp_op(CRFD, fA, fB); }
:ps_cmpo1 CRFD,fA,fB    is $(NOTVLE) & OP=4 & CRFD & BITS_21_22=0 & fA & fB & XOP_1_10=96  & Rc=0  { ps_cmp_op(CRFD, fA, fB); }

# Unary: fT = op(fB), fA field reserved
:ps_neg   fD,fB         is $(NOTVLE) & OP=4 & fD & BITS_16_20=0 & fB & XOP_1_10=40  & Rc=0  { fD = ps_neg_op(fB); }
:ps_neg.  fD,fB         is $(NOTVLE) & OP=4 & fD & BITS_16_20=0 & fB & XOP_1_10=40  & Rc=1  { fD = ps_neg_op(fB); cr1flags(); }
:ps_mr    fD,fB         is $(NOTVLE) & OP=4 & fD & BITS_16_20=0 & fB & XOP_1_10=72  & Rc=0  { fD = ps_mr_op(fB); }
:ps_mr.   fD,fB         is $(NOTVLE) & OP=4 & fD & BITS_16_20=0 & fB & XOP_1_10=72  & Rc=1  { fD = ps_mr_op(fB); cr1flags(); }
:ps_nabs  fD,fB         is $(NOTVLE) & OP=4 & fD & BITS_16_20=0 & fB & XOP_1_10=136 & Rc=0  { fD = ps_nabs_op(fB); }
:ps_nabs. fD,fB         is $(NOTVLE) & OP=4 & fD & BITS_16_20=0 & fB & XOP_1_10=136 & Rc=1  { fD = ps_nabs_op(fB); cr1flags(); }
:ps_abs   fD,fB         is $(NOTVLE) & OP=4 & fD & BITS_16_20=0 & fB & XOP_1_10=264 & Rc=0  { fD = ps_abs_op(fB); }
:ps_abs.  fD,fB         is $(NOTVLE) & OP=4 & fD & BITS_16_20=0 & fB & XOP_1_10=264 & Rc=1  { fD = ps_abs_op(fB); cr1flags(); }

# Lane merges: combine selected halves of fA and fB into fT
:ps_merge00 fD,fA,fB    is $(NOTVLE) & OP=4 & fD & fA & fB & XOP_1_10=528 & Rc=0  { fD = ps_merge00_op(fA, fB); }
:ps_merge00. fD,fA,fB   is $(NOTVLE) & OP=4 & fD & fA & fB & XOP_1_10=528 & Rc=1  { fD = ps_merge00_op(fA, fB); cr1flags(); }
:ps_merge01 fD,fA,fB    is $(NOTVLE) & OP=4 & fD & fA & fB & XOP_1_10=560 & Rc=0  { fD = ps_merge01_op(fA, fB); }
:ps_merge01. fD,fA,fB   is $(NOTVLE) & OP=4 & fD & fA & fB & XOP_1_10=560 & Rc=1  { fD = ps_merge01_op(fA, fB); cr1flags(); }
:ps_merge10 fD,fA,fB    is $(NOTVLE) & OP=4 & fD & fA & fB & XOP_1_10=592 & Rc=0  { fD = ps_merge10_op(fA, fB); }
:ps_merge10. fD,fA,fB   is $(NOTVLE) & OP=4 & fD & fA & fB & XOP_1_10=592 & Rc=1  { fD = ps_merge10_op(fA, fB); cr1flags(); }
:ps_merge11 fD,fA,fB    is $(NOTVLE) & OP=4 & fD & fA & fB & XOP_1_10=624 & Rc=0  { fD = ps_merge11_op(fA, fB); }
:ps_merge11. fD,fA,fB   is $(NOTVLE) & OP=4 & fD & fA & fB & XOP_1_10=624 & Rc=1  { fD = ps_merge11_op(fA, fB); cr1flags(); }
